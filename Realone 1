cat > "$ROOT/realone-pi/index.js" <<'JS'
/**
 * index.js - RealOne starter main
 */
const express = require('express');
const fs = require('fs');
const path = require('path');
const fetch = require('node-fetch');

const app = express();
const PORT = process.env.PORT || 3000;
const configPath = path.join(__dirname, 'config', 'default.json');
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(configPath)); } catch (e) { cfg = {}; }

app.get('/', (req, res) => res.send('RealOne active.'));
app.get('/status', (req, res) => res.json({
  status: 'ok',
  uptime: process.uptime(),
  time: new Date().toISOString()
}));

const HEARTBEAT_INTERVAL = (process.env.HEARTBEAT_INTERVAL || cfg.heartbeat_interval || 30) * 1000;

async function heartbeat() {
  try {
    console.log('[RealOne] heartbeat at', new Date().toISOString());
    if (cfg.ping_url) {
      const res = await fetch(cfg.ping_url).catch(()=>null);
      console.log('[RealOne] ping_url status', res ? res.status : 'failed');
    }
  } catch (err) {
    console.error('[RealOne] heartbeat error', err);
  } finally {
    setTimeout(heartbeat, HEARTBEAT_INTERVAL);
  }
}

app.listen(PORT, () => {
  console.log(`RealOne listening on port ${PORT}`);
  setTimeout(heartbeat, 2000);
});

process.on('SIGINT', () => { console.log('SIGINT'); process.exit(0); });
process.on('SIGTERM', () => { console.log('SIGTERM'); process.exit(0); });
JS

cat > "$ROOT/realone-pi/main.py" <<'PY'
#!/usr/bin/env python3
import time, signal, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
PORT = 3000

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/':
            self.send_response(200); self.end_headers()
            self.wfile.write(b'RealOne-Python active.')
        elif self.path == '/status':
            self.send_response(200); self.end_headers()
            data = {'status':'ok', 'time': time.ctime()}
            self.wfile.write(json.dumps(data).encode())
        else:
            self.send_response(404); self.end_headers()

def run():
    server = HTTPServer(('', PORT), Handler)
    def _stop(signum, frame):
        print('Stopping...'); server.shutdown(); sys.exit(0)
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    print(f'RealOne Python server at port {PORT}')
    server.serve_forever()

if __name__ == '__main__':
    run()
PY

