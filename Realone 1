cat > "$ROOT/pi-image-build/pi-gen-overlay/stage2/files/realone-setup.sh" <<'SETUPSH'
#!/bin/bash
# First-boot setup script run as pi user via systemd service wrapper

REALONE_REPO="https://github.com/YOUR-USERNAME/realone-pi.git"

if [ ! -f /etc/realone/setup_done ]; then
  echo "Welcome to RealOne first-boot setup."
  read -p "Wi-Fi Name (SSID): " WIFI_NAME
  read -sp "Wi-Fi Password: " WIFI_PASS
  echo

  mkdir -p /etc/realone
  echo "ssid=\"$WIFI_NAME\"" > /etc/realone/net.conf
  echo "psk=\"$WIFI_PASS\"" >> /etc/realone/net.conf

  wpa_passphrase "$WIFI_NAME" "$WIFI_PASS" > /etc/wpa_supplicant/wpa_supplicant.conf

  echo "BAKIbae@254#" | openssl enc -aes-256-cbc -pbkdf2 -out /etc/realone/vault.enc -k "RealOneKey" || true

  echo "[RealOne] Cloning RealOne app..."
  su - pi -c "git clone $REALONE_REPO /home/pi/RealOne || true"
  if [ -d /home/pi/RealOne ]; then
    su - pi -c "cd /home/pi/RealOne && npm install --production || true"
    su - pi -c "cd /home/pi/RealOne && pip3 install -r requirements.txt || true"
    chown -R pi:pi /home/pi/RealOne || true
  fi

  touch /etc/realone/setup_done
  echo "Setup complete. Rebooting..."
  reboot
else
  echo "[RealOne] Starting AI..."
  cd /home/pi/RealOne || true
  if [ -f index.js ]; then
    node index.js || true
  elif [ -f main.py ]; then
    python3 main.py || true
  else
    echo "No startup found. Sleeping indefinitely."
    sleep infinity
  fi
fi
SETUPSH

